{
  "name": "aligent/bypass2fa",
  "description": "Magento 2 module for bypassing 2-factor authentication in local development environments.",
  "type": "magento2-module",
  "require": {
    "php": ">=7.4",
    "magento/framework": "*",
    "magento/module-two-factor-auth": "1.1.*"
  },
  "license": [
    "Massachusetts Institute of Technology License (MITL)"
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Aligent\\Bypass2FA\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
